# Spotify Graph frontend (Vite). Copy to `.env` at the repo root.
#
# 1. Create an app: https://developer.spotify.com/dashboard
# 2. Redirect URI in that app must be exactly:
#    http://127.0.0.1:8888/callback
# 3. Paste the Dashboard Client ID below. Use the same value as
#    SPOTIFY_CLIENT_ID in backend/.env.

VITE_SPOTIFY_CLIENT_ID=
VITE_FRONTEND_LINK=http://127.0.0.1:8888/callback
