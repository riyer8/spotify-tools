{
  "name": "spotify-graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Personal Spotify library explorer — Explore, Stats, and Nights.",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --prefix backend",
