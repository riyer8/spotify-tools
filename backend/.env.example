# Spotify Graph backend. Copy to `backend/.env`.
# Setup steps: repo root README → Setup.
#
# The server exits on startup unless SPOTIFY_CLIENT_ID,
# SPOTIFY_CLIENT_SECRET, and BACKEND_PORT are set (non-empty).
#
# SPOTIFY_CLIENT_ID must match VITE_SPOTIFY_CLIENT_ID in the root `.env`.
# Get both id and secret from https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
BACKEND_PORT=8887
BACKEND_LINK=http://127.0.0.1:8887
